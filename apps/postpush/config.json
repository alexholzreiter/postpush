{
  "name": "PostPush",
  "id": "postpush",
  "available": true,
  "short_desc": "Plays a local spoken or custom mailbox announcement on selected HomePods.",
  "author": "Alexander Holzreiter",
  "port": 8586,
  "categories": ["automation", "utilities"],
  "description": "Local MQTT-to-AirPlay bridge for mailbox announcements with Piper TTS and custom audio.",
  "tipi_version": 10,
  "version": "0.2.9",
  "source": "https://github.com/alexholzreiter/postpush",
  "exposable": false,
  "dynamic_config": true,
  "supported_architectures": ["amd64", "arm64"],
  "form_fields": [
    {
      "type": "text",
      "label": "MQTT broker",
      "hint": "MQTT broker address, for example mqtt://192.168.1.27:1883",
      "default": "mqtt://192.168.1.27:1883",
      "min": 10,
      "max": 300,
      "required": true,
      "env_variable": "MQTT_URL"
    },
    {
      "type": "text",
      "label": "MQTT username",
      "default": "postpush",
      "min": 1,
      "max": 100,
      "required": true,
      "env_variable": "MQTT_USERNAME"
    },
    {
      "type": "password",
      "label": "MQTT password",
      "hint": "Password for the dedicated PostPush MQTT user.",
      "min": 8,
      "max": 300,
      "required": true,
      "env_variable": "MQTT_PASSWORD"
    },
    {
      "type": "text",
      "label": "MQTT topic",
      "default": "postpush/events/mail",
      "min": 1,
      "max": 200,
      "required": true,
      "env_variable": "MQTT_TOPIC"
    }
  ]
}
